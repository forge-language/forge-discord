import strings;
import fs;
extern fn fr_os_getenv(name: string): string;

fn parse_value(value: string): string {
    value = str_trim(value);
    if (str_len(value) == 0) { return ""; }
    let quote: int = str_char_at(value, 0);
    if (quote == 34 || quote == 39) {
        let i: int = 1;
        while (i < str_len(value) && str_char_at(value, i) != quote) { i = i + 1; }
        if (i >= str_len(value)) { return ""; }
        let tail: string = str_trim(str_sub(value, i + 1, str_len(value) - i - 1));
        if (str_len(tail) > 0 && str_char_at(tail, 0) != 35) { return ""; }
        return str_sub(value, 1, i - 1);
    }
    let end: int = 0;
    while (end < str_len(value) && str_char_at(value, end) != 35) { end = end + 1; }
    return str_trim(str_sub(value, 0, end));
}

fn token(path: string): string {
    return get(path, "DISCORD_TOKEN");
}

fn get(path: string, key: string): string {
    if (str_len(key) == 0 || str_contains(key, "=") || str_contains(key, "\n") || str_contains(key, "\r")) { return ""; }
    let value: string = fr_os_getenv(key);
    if (str_len(value) > 0) { return value; }
    return from_file(path, key);
}

fn token_from_file(path: string): string {
    return from_file(path, "DISCORD_TOKEN");
}

fn from_file(path: string, key: string): string {
    if (str_len(key) == 0 || str_contains(key, "=") || str_contains(key, "\n") || str_contains(key, "\r")) { return ""; }
    if (!fs_is_file(path)) { return ""; }
    let data: string = fs_read(path);
    let start: int = 0;
    let length: int = str_len(data);
    while (start < length) {
        let end: int = start;
        while (end < length && str_char_at(data, end) != 10) { end = end + 1; }
        let line: string = str_trim(str_sub(data, start, end - start));
        if (str_len(line) >= 7 && str_eq(str_sub(line, 0, 7), "export ")) { line = str_trim(str_sub(line, 7, str_len(line) - 7)); }
        let equal: int = 0;
        while (equal < str_len(line) && str_char_at(line, equal) != 61) { equal = equal + 1; }
        if (equal < str_len(line) && str_eq(str_trim(str_sub(line, 0, equal)), key)) {
            return parse_value(str_sub(line, equal + 1, str_len(line) - equal - 1));
        }
        start = end + 1;
    }
    return "";
}
