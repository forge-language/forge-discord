import net;
import strings;

extern fn fr_tls_listen(host: string, port: int, cert: string, key: string): int;
extern fn fr_tls_port(listener: int): int;
extern fn fr_tls_accept(listener: int, timeout_ms: int): int;
extern fn fr_tls_read(connection: int, max_bytes: int, timeout_ms: int): int;
extern fn fr_tls_write(connection: int, data: int, timeout_ms: int): int;
extern fn fr_tls_close(handle: int): int;
extern fn fr_sha1(data: int): int;

fn read_exact(connection: int, count: int): int {
    if (count < 0 || count > 1048576) { return -1; }
    let out: int = buffer_new(); if (out < 0) { return -1; }
    while (buffer_len(out) < count) {
        let part: int = fr_tls_read(connection, count - buffer_len(out), 10000);
        if (part <= 0) { buffer_free(out); return -1; }
        let status: int = buffer_append_buffer(out, part); buffer_free(part);
        if (status < 0) { buffer_free(out); return -1; }
    }
    return out;
}

fn handshake(connection: int): int {
    let headers: int = buffer_new(); if (headers < 0) { return -1; }
    while (buffer_len(headers) < 8192) {
        let part: int = fr_tls_read(connection, 1, 10000);
        if (part <= 0) { buffer_free(headers); return -1; }
        let status: int = buffer_append_buffer(headers, part); buffer_free(part);
        if (status < 0) { buffer_free(headers); return -1; }
        let n: int = buffer_len(headers);
        if (n >= 4 && buffer_get(headers, n - 4) == 13 && buffer_get(headers, n - 3) == 10 && buffer_get(headers, n - 2) == 13 && buffer_get(headers, n - 1) == 10) {
            let text: string = buffer_string(headers);
            let prefix: string = "Sec-WebSocket-Key:"; let i: int = 0; let start: int = -1;
            while (i + str_len(prefix) <= str_len(text)) {
                if (str_eq(str_sub(text, i, str_len(prefix)), prefix)) { start = i + str_len(prefix); i = str_len(text); } else { i = i + 1; }
            }
            if (start < 0) { buffer_free(headers); return -1; }
            let end: int = start;
            while (end < str_len(text) && str_char_at(text, end) != 13) { end = end + 1; }
            let key: string = str_trim(str_sub(text, start, end - start));
            let input: int = buffer_from_string(str_concat(key, "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"));
            if (input < 0) { buffer_free(headers); return -1; }
            let digest: int = fr_sha1(input); buffer_free(input);
            if (digest < 0) { buffer_free(headers); return -1; }
            let accept: string = buffer_base64(digest);
            let response: string = str_concat(str_concat("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ", accept), "\r\n\r\n");
            let reply: int = buffer_from_string(response); buffer_free(digest); buffer_free(headers);
            if (reply < 0) { return -1; }
            let written: int = fr_tls_write(connection, reply, 10000); buffer_free(reply); return written;
        }
    }
    buffer_free(headers); return -1;
}

fn xor_byte(a: int, b: int): int {
    let result: int = 0; let bit: int = 1;
    while (bit <= 128) { if ((a / bit) % 2 != (b / bit) % 2) { result = result + bit; } bit = bit * 2; }
    return result;
}

// Return an owned buffer containing opcode followed by the unmasked payload.
fn read_frame(connection: int): int {
    let header: int = read_exact(connection, 2); if (header < 0) { return -1; }
    let first: int = buffer_get(header, 0); let second: int = buffer_get(header, 1); buffer_free(header);
    if (first / 128 != 1 || second / 128 != 1) { return -1; }
    let length: int = second % 128;
    if (length == 126) {
        let extended: int = read_exact(connection, 2); if (extended < 0) { return -1; }
        length = buffer_get(extended, 0) * 256 + buffer_get(extended, 1); buffer_free(extended);
    } else if (length == 127) { return -1; }
    let mask: int = read_exact(connection, 4); if (mask < 0) { return -1; }
    let data: int = read_exact(connection, length); if (data < 0) { buffer_free(mask); return -1; }
    let frame: int = buffer_new();
    if (frame < 0 || buffer_append(frame, first % 16) < 0) { if (frame > 0) { buffer_free(frame); } buffer_free(mask); buffer_free(data); return -1; }
    let i: int = 0;
    while (i < length) {
        if (buffer_append(frame, xor_byte(buffer_get(data, i), buffer_get(mask, i % 4))) < 0) { buffer_free(frame); buffer_free(mask); buffer_free(data); return -1; }
        i = i + 1;
    }
    buffer_free(mask); buffer_free(data); return frame;
}

fn send_frame(connection: int, opcode: int, data: int): int {
    let n: int = buffer_len(data);
    if (n < 0 || n > 65535 || opcode < 1 || opcode > 15) { return -1; }
    let frame: int = buffer_new(); if (frame < 0) { return -1; }
    if (buffer_append(frame, 128 + opcode) < 0) { buffer_free(frame); return -1; }
    if (n < 126) { if (buffer_append(frame, n) < 0) { buffer_free(frame); return -1; } }
    else if (buffer_append(frame, 126) < 0 || buffer_append(frame, n / 256) < 0 || buffer_append(frame, n % 256) < 0) { buffer_free(frame); return -1; }
    if (buffer_append_buffer(frame, data) < 0) { buffer_free(frame); return -1; }
    let result: int = fr_tls_write(connection, frame, 10000); buffer_free(frame); return result;
}

fn send_text(connection: int, text: string): int {
    let data: int = buffer_from_string(text); if (data < 0) { return -1; }
    let result: int = send_frame(connection, 1, data); buffer_free(data); return result;
}
