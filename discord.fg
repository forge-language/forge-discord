import strings;

fn api_url(path: string): string {
    if (str_len(path) == 0 || str_char_at(path, 0) != 47) { return ""; }
    return str_concat("https://discord.com/api/v10", path);
}

fn authorization(token: string): string {
    if (str_len(token) == 0 || str_contains(token, "\n") || str_contains(token, "\r")) { return ""; }
    return str_concat("Authorization: Bot ", token);
}

fn quote(content: string): string {
    let builder: int = str_builder();
    str_builder_append(builder, "\"");
    let i: int = 0;
    while (i < str_len(content)) {
        let ch: int = str_char_at(content, i);
        if (ch == 34 || ch == 92) { str_builder_char(builder, 92); str_builder_char(builder, ch); }
        else if (ch < 32) {
            str_builder_append(builder, "\\u00");
            let hex: string = "0123456789abcdef";
            str_builder_char(builder, str_char_at(hex, ch / 16));
            str_builder_char(builder, str_char_at(hex, ch % 16));
        } else { str_builder_char(builder, ch); }
        i = i + 1;
    }
    str_builder_append(builder, "\"");
    return str_builder_finish(builder);
}

fn hex4(value: string, start: int): int {
    if (start < 0 || start + 4 > str_len(value)) { return -1; }
    let result: int = 0; let i: int = 0;
    while (i < 4) {
        let c: int = str_char_at(value, start + i); let n: int = -1;
        if (c >= 48 && c <= 57) { n = c - 48; }
        else if (c >= 65 && c <= 70) { n = c - 65 + 10; }
        else if (c >= 97 && c <= 102) { n = c - 97 + 10; }
        if (n < 0) { return -1; }
        result = result * 16 + n; i = i + 1;
    }
    return result;
}

fn append_utf8(builder: int, code: int): int {
    if (code <= 0 || code > 1114111 || (code >= 55296 && code <= 57343)) { return -1; }
    if (code < 128) { str_builder_char(builder, code); }
    else if (code < 2048) { str_builder_char(builder, 192 + code / 64); str_builder_char(builder, 128 + code % 64); }
    else if (code < 65536) { str_builder_char(builder, 224 + code / 4096); str_builder_char(builder, 128 + (code / 64) % 64); str_builder_char(builder, 128 + code % 64); }
    else { str_builder_char(builder, 240 + code / 262144); str_builder_char(builder, 128 + (code / 4096) % 64); str_builder_char(builder, 128 + (code / 64) % 64); str_builder_char(builder, 128 + code % 64); }
    return 0;
}

fn json_string(raw: string): string {
    let length: int = str_len(raw);
    if (length < 2 || str_char_at(raw, 0) != 34 || str_char_at(raw, length - 1) != 34) { return ""; }
    let b: int = str_builder(); let i: int = 1;
    while (i < length - 1) {
        let c: int = str_char_at(raw, i); i = i + 1;
        if (c < 32 || c == 34) { return ""; }
        if (c == 92) {
            if (i >= length - 1) { return ""; }
            c = str_char_at(raw, i); i = i + 1;
            if (c == 34 || c == 92 || c == 47) { str_builder_char(b, c); }
            else if (c == 98) { str_builder_char(b, 8); }
            else if (c == 102) { str_builder_char(b, 12); }
            else if (c == 110) { str_builder_char(b, 10); }
            else if (c == 114) { str_builder_char(b, 13); }
            else if (c == 116) { str_builder_char(b, 9); }
            else if (c == 117) {
                if (i + 4 > length - 1) { return ""; }
                let code: int = hex4(raw, i); i = i + 4;
                if (code >= 55296 && code <= 56319) {
                    if (i + 6 > length - 1 || str_char_at(raw, i) != 92 || str_char_at(raw, i + 1) != 117) { return ""; }
                    let low: int = hex4(raw, i + 2);
                    if (low < 56320 || low > 57343) { return ""; }
                    code = 65536 + (code - 55296) * 1024 + low - 56320; i = i + 6;
                }
                if (append_utf8(b, code) < 0) { return ""; }
            } else { return ""; }
        } else { str_builder_char(b, c); }
    }
    return str_builder_finish(b);
}

fn message_json(content: string): string {
    return str_concat(str_concat("{\"content\":", quote(content)), "}");
}

fn id_valid(id: string): int {
    if (str_len(id) == 0 || str_len(id) > 20) { return 0; }
    let i: int = 0;
    while (i < str_len(id)) {
        let c: int = str_char_at(id, i);
        if (c < 48 || c > 57) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn channel_path(channel: string): string {
    if (!id_valid(channel)) { return ""; }
    return str_concat("/channels/", channel);
}

fn messages_path(channel: string): string {
    let path: string = channel_path(channel);
    if (str_len(path) == 0) { return ""; }
    return str_concat(path, "/messages");
}

fn guild_path(guild: string): string {
    if (!id_valid(guild)) { return ""; }
    return str_concat("/guilds/", guild);
}

fn child_path(parent: string, collection: string, id: string): string {
    if (str_len(parent) == 0 || str_len(collection) == 0) { return ""; }
    let i: int = 0;
    while (i < str_len(collection)) {
        let c: int = str_char_at(collection, i);
        if (c < 97 || c > 122) { return ""; }
        i = i + 1;
    }
    let path: string = str_concat(str_concat(parent, "/"), collection);
    if (str_len(id) == 0) { return path; }
    if (!id_valid(id)) { return ""; }
    return str_concat(str_concat(path, "/"), id);
}

fn url_encode(value: string): string {
    let b: int = str_builder();
    let hex: string = "0123456789ABCDEF";
    let i: int = 0;
    while (i < str_len(value)) {
        let c: int = str_char_at(value, i);
        if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45 || c == 46 || c == 95 || c == 126) { str_builder_char(b, c); }
        else { str_builder_char(b, 37); str_builder_char(b, str_char_at(hex, c / 16)); str_builder_char(b, str_char_at(hex, c % 16)); }
        i = i + 1;
    }
    return str_builder_finish(b);
}

fn reaction_path(channel: string, message: string, emoji: string, user: string): string {
    let path: string = messages_path(channel);
    if (str_len(path) == 0 || !id_valid(message) || str_len(emoji) == 0 || (!str_eq(user, "@me") && !id_valid(user))) { return ""; }
    let b: int = str_builder();
    str_builder_append(b, path); str_builder_append(b, "/"); str_builder_append(b, message);
    str_builder_append(b, "/reactions/"); str_builder_append(b, url_encode(emoji));
    str_builder_append(b, "/"); str_builder_append(b, user);
    return str_builder_finish(b);
}

fn guild_special_path(guild: string, resource: string, id: string): string {
    let base: string = guild_path(guild);
    if (str_len(base) == 0) { return ""; }
    if (!str_eq(resource, "audit-logs") && !str_eq(resource, "auto-moderation/rules") && !str_eq(resource, "scheduled-events")) { return ""; }
    if (str_len(id) > 0 && !id_valid(id)) { return ""; }
    let path: string = str_concat(str_concat(base, "/"), resource);
    if (str_len(id) > 0) { path = str_concat(str_concat(path, "/"), id); }
    return path;
}

fn seconds_ms(value: string): int {
    let length: int = str_len(value);
    if (length == 0) { return -1; }
    let whole: int = 0;
    let fraction: int = 0;
    let places: int = 0;
    let dot: int = 0;
    let digits: int = 0;
    let round_up: int = 0;
    let i: int = 0;
    while (i < length) {
        let c: int = str_char_at(value, i);
        if (c == 46 && dot == 0 && digits > 0) { dot = 1; }
        else if (c >= 48 && c <= 57) {
            digits = digits + 1;
            if (dot == 0) {
                whole = whole * 10 + c - 48;
                if (whole > 86400) { return -1; }
            } else if (places < 3) { fraction = fraction * 10 + c - 48; places = places + 1; }
            else if (c != 48) { round_up = 1; }
        } else { return -1; }
        i = i + 1;
    }
    if (dot != 0 && places == 0) { return -1; }
    while (places < 3) { fraction = fraction * 10; places = places + 1; }
    return whole * 1000 + fraction + round_up;
}
